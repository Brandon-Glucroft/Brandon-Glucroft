/* General */
body {
    font-family: Arial, sans-serif;
    margin: 0;
    background-color: #f4f4f4;
    color: #222;
    line-height: 1.6;
}

/* Navigation */
nav {
    background-color: #1f2937;
    padding: 18px;
    text-align: center;
    position: sticky;
    top: 0;
}

nav a {
    color: white;
    text-decoration: none;
    margin: 0 18px;
    font-weight: bold;
}

nav a:hover {
    text-decoration: underline;
}

/* Header */
header {
    text-align: center;
    padding: 90px 20px;
    background-color: white;
}

header h1 {
    font-size: 48px;
    margin: 0;
}

header h2 {
    font-size: 24px;
    font-weight: normal;
    margin: 10px 0;
}

header p {
    font-size: 18px;
}

/* Sections */
section {
    max-width: 900px;
    margin: 40px auto;
    padding: 35px;
    background-color: white;
    border-radius: 10px;
}

section h2 {
    color: #1f2937;
    border-bottom: 2px solid #1f2937;
    padding-bottom: 10px;
}

/* Links */
a {
    color: #1f2937;
}

/* Mobile-Friendly Design */
@media (max-width: 600px) {

    header {
        padding: 60px 15px;
    }

    header h1 {
        font-size: 36px;
    }

    header h2 {
        font-size: 20px;
    }

    nav a {
        display: block;
        margin: 8px;
    }

    section {
        margin: 20px 10px;
        padding: 25px;
    }
}
