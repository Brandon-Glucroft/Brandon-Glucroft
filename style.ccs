/* General */
body {
    font-family: Arial, sans-serif;
    margin: 0;
    background-color: #f5f5f5;
    color: #222;
    line-height: 1.6;
}

/* Navigation */
nav {
    background-color: #222;
    padding: 15px;
    text-align: center;
}

nav a {
    color: white;
    text-decoration: none;
    margin: 0 15px;
    font-weight: bold;
}

nav a:hover {
    text-decoration: underline;
}

/* Header */
header {
    text-align: center;
    padding: 70px 20px;
    background-color: #ffffff;
}

header h1 {
    font-size: 42px;
    margin-bottom: 10px;
}

header h2 {
    font-weight: normal;
}

/* Sections */
section {
    max-width: 900px;
    margin: 40px auto;
    padding: 30px;
    background-color: white;
    border-radius: 10px;
}

section h2 {
    border-bottom: 2px solid #222;
    padding-bottom: 10px;
}

/* Mobile-friendly design */
@media (max-width: 600px) {
    header h1 {
        font-size: 32px;
    }

    nav a {
        display: block;
        margin: 10px;
    }

    section {
        margin: 20px 10px;
        padding: 20px;
    }
}
